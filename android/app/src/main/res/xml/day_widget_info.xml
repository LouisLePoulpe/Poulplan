<?xml version="1.0" encoding="utf-8"?>
<!-- Re-rendered every 30 min from the last snapshot, so that « today »
     stays right with the app closed; the app also pushes updates. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_day_description"
    android:initialLayout="@layout/widget_day"
    android:previewLayout="@layout/widget_day_preview"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
