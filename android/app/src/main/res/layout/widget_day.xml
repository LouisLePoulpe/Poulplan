<?xml version="1.0" encoding="utf-8"?>
<!-- « Journée » as a time line (Android 12+): the hours and the « now » line
     are drawn in day_grid; the event boxes are positioned over it from the
     code (RemoteViews.setViewLayoutMargin/Width/Height). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">
        <LinearLayout
            android:id="@+id/day_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_day_title"
                android:textColor="#FFE600"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/day_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFF6C2"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_add_background"
            android:contentDescription="@string/widget_add"
            android:gravity="center"
            android:text="+"
            android:textColor="#2C1E00"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tl_allday_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tl_allday_0"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tl_allday_1"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/day_timeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/day_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_day_description"
            android:scaleType="fitXY" />
        <TextView
            android:id="@+id/tl_event_0"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tl_event_1"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tl_event_2"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tl_event_3"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tl_event_4"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tl_event_5"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tl_event_6"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tl_event_7"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
