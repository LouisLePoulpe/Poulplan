    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"category_id\" TEXT NULL REFERENCES categories (id), \"color\" INTEGER NULL, \"location\" TEXT NULL, \"video_link\" TEXT NULL, \"busy\" INTEGER NOT NULL DEFAULT 1 CHECK (\"busy\" IN (0, 1)), \"all_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"all_day\" IN (0, 1)), \"start_utc\" INTEGER NOT NULL, \"end_utc\" INTEGER NOT NULL, \"time_zone\" TEXT NOT NULL, \"rrule\" TEXT NULL, \"holiday_rule\" TEXT NOT NULL DEFAULT 'none', \"series_id\" TEXT NULL, \"original_start_utc\" INTEGER NULL, \"cancelled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"cancelled\" IN (0, 1)), \"recurrence_end_utc\" INTEGER NULL, \"reminders\" TEXT NOT NULL DEFAULT '[]', \"search_text\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "birthdays",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"birthdays\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"month\" INTEGER NOT NULL, \"day\" INTEGER NOT NULL, \"birth_year\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
